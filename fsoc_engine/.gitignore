# =============================================================================
# ISRO FSOC Tracker - Git Ignore Rules
# =============================================================================

# Reports Directories & Artifacts (Full Reports Suites)
reports/
tech_reports/
*/reports/
*/tech_reports/
*report*/
*REPORT*.html
PHASE*_REPORT.html
FINAL_TECHNICAL_REPORT.html
00_PROJECT_ROADMAP.html
*.html
*.docx
!web_dist/**
!web_dist/index.html

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
release/*.exe
release/*.zip
release/*.dmg
release/checksums*.txt
!release/RELEASE_NOTES.md
!release/START_HERE.txt
*.spec.bak
*.spec~
!NETRA.spec
eggs/
.eggs/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.cache

# Video Assets & Large Benchmark Artifacts
*.mp4
*.avi
*.mov
*.mkv
benchmark_results/
data/

# Environments & IDEs
.env
.venv
env/
venv/
ENV/
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS Files
.DS_Store
Thumbs.db
desktop.ini
